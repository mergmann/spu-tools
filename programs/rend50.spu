vector:
    JMP start
    RTI
    RTI
    RTI
    RTI
    RTI
    RTI
    RTI

start:
    # Warmup code
    LD r0, X[$0000]
    LD r0, X[$0000]
    LD r0, X[$0000]
    LD r0, X[$0000]

    # Saturate, round up
    LDI fl, #0x0801

    # Pointer to vertices
    LDI p0, $0001

    # Pointer to matrix
    LDI b0, $0400

    # Reload b every 12 uses, inc 1
    LDI bo0, #1
    LDI bm0, #0x400C

    LD r0, X[$0000]
    DO r0, outer
    # yummy delay slots
    NOP
    NOP
    
    LDI r0, #1024
    DO r0, inner
    NOP
    NOP

    # vertex3 * matrix34 (14 cycles)
    # a0: x
    # a1: y
    # a2: z
    NOP            || ld r3, Y[b0+OM] | ld r0, X[p0+]
    MUL a0, r0, r3 || ld r2, Y[b0+OM]
    MUL a1, r0, r2 || ld r3, Y[b0+OM] | ld r1, X[p0+]
    MUL a2, r0, r3 || ld r2, Y[b0+OM]
    MAC a0, r1, r2 || ld r3, Y[b0+OM]
    MAC a1, r1, r3 || ld r2, Y[b0+OM] | ld r0, X[p0+]
    MAC a2, r1, r2 || ld r3, Y[b0+OM]
    MAC a0, r0, r3 || ld r2, Y[b0+OM]
    MAC a1, r0, r2 || ld r3, Y[b0+OM]
    MAC a2, r0, r3 || ld r2, Y[b0+OM]
    NOP            || ld r3, Y[b0+OM]
    ADD a0, a0, r2 || ld r2, Y[b0+OM]
    ADD a1, a1, r3
    ADD r2, a2, r2

    # recip table length
    LDI r0, #0x400

    # load guess from recip table
    MUL a3, r2, r0
    NOP
    NOP || mv b1, a3.hi
    NOP || ld r3, Y[b1]

    # Newton's method
    # Q = 1 / (8z)
    NOP || mv a3, r3
    # a2 = zQ
    MUL a2, r2, r3
    NOP
    # r0 = 4zQ
    SHLH r0, a2, #2
    # a3 = Q - 4zQ²
    MAC a3, -r3, r0
    NOP
    # r3 = 2Q - 8zQ²
    SHLH r3, a3, #1 || mv r0, a0

    # x' = x * (1/z)
    MUL a0, r0, r3  || mv r1, a1
    MUL a1, r1, r3
    NOP             || mv r0, a0
    NOP             || mv r1, a1

    # to screen coords
    LDI r2, #900
    MUL a0,  r0, r2
    MUL a1, -r1, r2
    LDI r3, #198
    ADD a0, a0, r3
    LDI r3, #112
    ADD a1, a1, r3

    # clamp
    LDI r3, #395
    MIN a0, a0, r3
    LDI r3, #191
    MIN a1, a1, r3
    LDI r3, #0
    MAX a0, a0, r3
    MAX r1, a1, r3

    # calculate addr
    NOP || mv a0.lo, a0.hi
    LDI r3, #198
    MAC a0, r1, r3
    
    LDI r3, #25
    SHL.E r2, a0, r3
    LDI r3, #0xA0
    ADD r2, r2, r3
    ST IO[$FF57], r2

    LDI r3, #16
    SHR.E r1, r2, r3
    LDI r3, #0x0C0F
    ADD r3, r1, r3

    ST IO[$FF56], r3
    LDI r3, #0x1010

    # draw
    STI IO[$FF59], #0000
inner:
    ST IO[$FF5C], r3
outer:
    NOP
    STI X[$0000], #42
    HALT
